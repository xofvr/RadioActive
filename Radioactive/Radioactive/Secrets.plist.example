<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Copy this file to `Secrets.plist` (same folder) and paste your real key.
  Secrets.plist is gitignored — the key never enters source control, but is
  bundled into the build. No key ⇒ the app runs keyless (MapKit simulated readings).
-->
<plist version="1.0">
<dict>
	<key>GOOGLE_PLACES_API_KEY</key>
	<string>YOUR_GOOGLE_PLACES_API_KEY</string>
</dict>
</plist>
